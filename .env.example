# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Datastore ----
# Path to the SQLite database file.
DATABASE_PATH=./data/app.sqlite

# ---- Shopify ----
# Your store domain, e.g. my-store.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com
# Admin API access token from your custom app.
SHOPIFY_ACCESS_TOKEN=
# Secret used to verify incoming webhook HMAC signatures.
SHOPIFY_WEBHOOK_SECRET=
# Admin API version, e.g. 2024-10
SHOPIFY_API_VERSION=2024-10

# ---- AutoDS ----
# "live" calls the real AutoDS API (needs the token below).
# "mock" uses a built-in fake catalogue + fake fulfillment so the whole
# pipeline runs end-to-end with NO AutoDS account. Use this until AutoDS
# sends the real API docs/credentials after activation.
AUTODS_MODE=mock
# AutoDS API base URL (depends on plan/access).
AUTODS_API_BASE=https://api.autods.com
# AutoDS API token/key.
AUTODS_API_TOKEN=
# AutoDS store id (if applicable).
AUTODS_STORE_ID=

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=
# Model to use for generation.
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Max tokens per completion.
CLAUDE_MAX_TOKENS=1024
# LLM provider: "anthropic" (default, calls the Anthropic API directly) or
# "openrouter" (routes through openrouter.ai, useful for price-shopping
# across models/providers). Prompt caching only applies to "anthropic".
CLAUDE_PROVIDER=anthropic
# Required when CLAUDE_PROVIDER=openrouter. Create a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug to use via OpenRouter, e.g. anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ---- Automation behaviour ----
# When true, AI content and orders auto-publish/auto-fulfill.
# When false, they require manual approval (human-in-the-loop).
AUTO_PUBLISH=false
AUTO_FULFILL=false
# Cron schedule for the recurring price/stock sync job.
SYNC_CRON=*/30 * * * *

# ---- Admin API ----
# REQUIRED to use /admin (min 16 chars). Send as: Authorization: Bearer <token>
# Unset = /admin refuses every request.
ADMIN_TOKEN=

# ---- Pricing (percentages are of the SELLING price) ----
# Set the fee rates from YOUR Shopify payments plan; they vary by plan/country.
PRICING_TARGET_MARGIN_PCT=30
PRICING_MIN_MARGIN_PCT=15
PRICING_PAYMENT_FEE_PCT=0
PRICING_PAYMENT_FIXED_FEE=0
# Round prices up to x.99
PRICING_CHARM=true

# ---- Order risk gate (applies when AUTO_FULFILL=true) ----
# RISK_GATE=off disables it (not recommended).
RISK_GATE=on
RISK_REQUIRE_PAID=true
RISK_MAX_QTY_PER_LINE=5
RISK_MAX_ORDER_VALUE=500
# Comma-separated ISO codes you ship to, e.g. CA,US. Empty = any.
RISK_ALLOWED_COUNTRIES=
RISK_MAX_ORDERS_PER_EMAIL_PER_DAY=3
RISK_MAX_ORDER_AGE_DAYS=7

# ---- Listing compliance ----
# Comma-separated words that hold a product for review (brands, restricted
# goods). Default list is a starter; tune it for your niche.
# BLOCKED_TERMS=

# ---- Round 3 hardening ----
# Hold orders with more line items than this.
RISK_MAX_LINE_ITEMS=25
# Hold orders whose goods total (after discounts) is below supplier cost.
RISK_HOLD_BELOW_COST=true
# Hold orders containing a SKU this app did not list.
RISK_REQUIRE_KNOWN_SKU=false
# Webhook requests per minute per IP (Shopify retries on 429).
WEBHOOK_RATE_LIMIT_PER_MIN=600
# Set to 1 when behind one reverse proxy so rate limits see real client IPs.
TRUST_PROXY_HOPS=
